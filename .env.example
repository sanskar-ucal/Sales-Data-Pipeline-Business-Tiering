# Copy to .env and adjust. docker-compose overrides PG_HOST to the postgres service.

# Warehouse: postgres | snowflake
WAREHOUSE_TYPE=postgres
DBT_TARGET=postgres

PG_HOST=localhost
PG_PORT=5432
PG_USER=pipeline
PG_PASSWORD=pipeline
PG_DATABASE=sales_dw

# Snowflake (WAREHOUSE_TYPE=snowflake, DBT_TARGET=snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_DATABASE=SALES_DW

# Alerting (any channel left blank is skipped; alerts always go to the task log)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Tableau Server / Cloud publishing (optional)
TABLEAU_SERVER_URL=
TABLEAU_SITE=
TABLEAU_TOKEN_NAME=
TABLEAU_TOKEN_SECRET=
TABLEAU_PROJECT=Sales Analytics
